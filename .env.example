# Copy to .env for local runs. In GitHub, the secrets go in
# Settings > Secrets and variables > Actions > Secrets, and the plain values go
# in the Variables tab beside them. Nothing here belongs in a commit.

# ---- model auth (one of these) -------------------------------------------
# Subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=YOUR_CLAUDE_CODE_OAUTH_TOKEN
# Or a metered API key.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ---- telegram -------------------------------------------------------------
# From BotFather. The bot only ever talks to one chat.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Your numeric chat id. The bridge rejects updates from any other sender, which
# is the entire authorization model on the Telegram side.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# A random string you also hand to setWebhook. Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ---- github ---------------------------------------------------------------
# Read only token. This is what the cycles get.
GH_TOKEN_READONLY=YOUR_READONLY_TOKEN
# Write token, scoped to the target repository alone. Used by the nightly cycle
# to push a branch and open a pull request, and by the executor to merge.
GH_TOKEN_WRITE=YOUR_WRITE_TOKEN
# The repository the agent works on.
TARGET_REPO=owner/repo
# Nothing outside this list can be merged, whatever a dispatch payload claims.
ALLOWED_REPOS=owner/repo
DEFAULT_BRANCH=main

# ---- telemetry ------------------------------------------------------------
# A dedicated read only database role. Not the application's connection string.
# Grant SELECT on the tables the brief needs and nothing else.
TELEMETRY_DATABASE_URL=postgres://readonly_user:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE

# ---- governance -----------------------------------------------------------
# Dollars per calendar month across every cycle. Preflight exits 78 at the cap.
BUDGET_MONTHLY=100
# Dollars for one run. record-run exits 79 above it, after the work is recorded.
RUNNER_MAX_USD=10
# 1 means print what would be sent or merged and do nothing. Start here.
DRY_RUN=1
# The executor's own switch, because an approved tap must not silently no-op.
EXECUTOR_DRY_RUN=1
# 1 stops every cycle before it starts, no questions.
KILL_SWITCH=0
# api uses the GitHub merge endpoint with a sha guard, git uses --ff-only.
MERGE_MODE=api
MERGE_METHOD=squash
# Where the cost ledger is written.
SPEND_LEDGER=state/spend.jsonl
